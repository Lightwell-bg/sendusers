# Токены ботов (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN_A=
TELEGRAM_BOT_TOKEN_B=

# Пароль администратора и секрет для подписи cookie-сессии/CSRF
# SECRET_KEY сгенерировать командой: openssl rand -hex 32
ADMIN_PASSWORD=
SECRET_KEY=

# Chat ID администратора — сюда уходит "тестовая отправка на себя"
# (свой ID можно узнать у бота @userinfobot)
ADMIN_CHAT_ID=

# Пути к базам данных ботов (только чтение, эти базы не изменяются).
# Значения ниже — пути ВНУТРИ контейнера broadcast-admin (см. docker-compose.yml).
BOT_A_DB_PATH=/dbs/bot_a/bot_data.sqlite
BOT_B_DB_PATH=/dbs/bot_b/chat_logs.db

# Пути НА ХОСТЕ (VPS) для docker-compose — у обоих ботов их база лежит в
# отдельном каталоге data/ (не рядом с .env бота), поэтому монтируем каталог
# целиком (см. комментарий в docker-compose.yml) — так подхватываются и
# файлы WAL-режима (-wal/-shm) бота B, если они есть.
BOT_A_DATA_DIR=/opt/bginfobot/data
BOT_B_DATA_DIR=/opt/bginfoai/data

# Путь к собственной базе сервиса рассылок (кампании, снапшоты получателей)
BROADCAST_DB_PATH=data/broadcast.db

# Каталог для загруженных картинок кампаний (том ./data монтируется в контейнер)
UPLOADS_DIR=data/uploads

# Чаты, участников которых не рассылаем (через запятую, с @)
EXCLUDE_CHATS=@bginfosuchat,@bginfosu

# Пауза между отправками сообщений, сек
SEND_DELAY=0.08
# Пауза между проверками членства в чате (getChatMember), сек
MEMBER_CHECK_DELAY=0.1
# Срок жизни кэша членства в чате, часов (для статуса "участник" — можно кэшировать дольше)
MEMBERSHIP_TTL_HOURS=24
# Срок жизни кэша для НЕ-участников ("left"/"kicked"), часов — короче, чтобы не
# пропустить того, кто уже успел вступить в чат заново
MEMBERSHIP_TTL_NONMEMBER_HOURS=1

# Адрес и порт, на которых слушает сервис (сервис не должен смотреть в интернет напрямую)
HOST=127.0.0.1
PORT=8080

# Порт НА ХОСТЕ для docker-compose (внутри контейнера всегда 8080, см. Dockerfile).
# Если 8080 на сервере уже занят другим проектом — смените на свободный.
HOST_PORT=8090

# Адрес привязки порта на хосте:
#   127.0.0.1 — только локально, доступ через SSH-туннель (безопасно, по умолчанию)
#   0.0.0.0   — открыть по IP сервера всему интернету (БЕЗ HTTPS — пароль/cookie
#               идут открытым текстом; открывайте, понимая риск)
BIND_ADDR=127.0.0.1

# Secure-флаг сессионной cookie: 0 при доступе через SSH-туннель (http://127.0.0.1),
# 1 — если админка опубликована за HTTPS (reverse-proxy/Cloudflare)
COOKIE_SECURE=0

# Уровень логирования (DEBUG/INFO/WARNING/ERROR). INFO нужен, чтобы прогресс
# dry-run/отправки и resume после рестарта были видны в `docker compose logs`
LOG_LEVEL=INFO

# Сколько получателей проверять на членство в exclude-чатах одновременно
# во время dry-run (иначе проверка идёт строго по одному)
MEMBERSHIP_CHECK_CONCURRENCY=5

# Период проверки очереди отправки — раз в сколько секунд фоновый
# обработчик проверяет, не пора ли запускать следующую запланированную
# кампанию (не пользовательская настройка в обычном смысле, но полезно
# иметь возможность ускорить для тестов/отладки)
QUEUE_TICK_SECONDS=5
