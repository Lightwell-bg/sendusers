# Токены ботов (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN_A=
TELEGRAM_BOT_TOKEN_B=

# Пароль администратора и секрет для подписи cookie-сессии/CSRF
# SECRET_KEY сгенерировать командой: openssl rand -hex 32
ADMIN_PASSWORD=
SECRET_KEY=

# Пути к базам данных ботов (только чтение, эти базы не изменяются).
# Значения ниже — пути ВНУТРИ контейнера broadcast-admin (см. docker-compose.yml).
BOT_A_DB_PATH=/dbs/bot_a/bot_data.sqlite
BOT_B_DB_PATH=/dbs/bot_b/chat_logs.db

# Пути НА ХОСТЕ (VPS) для docker-compose — у обоих ботов их база лежит в
# отдельном каталоге data/ (не рядом с .env бота), поэтому монтируем каталог
# целиком (см. комментарий в docker-compose.yml) — так подхватываются и
# файлы WAL-режима (-wal/-shm) бота B, если они есть.
BOT_A_DATA_DIR=/opt/bginfobot/data
BOT_B_DATA_DIR=/opt/bginfoai/data

# Путь к собственной базе сервиса рассылок (кампании, снапшоты получателей)
BROADCAST_DB_PATH=data/broadcast.db

# Каталог для загруженных картинок кампаний (том ./data монтируется в контейнер)
UPLOADS_DIR=data/uploads

# Адрес и порт, на которых слушает сервис (сервис не должен смотреть в интернет напрямую)
HOST=127.0.0.1
PORT=8080

# Порт НА ХОСТЕ для docker-compose (внутри контейнера всегда 8080, см. Dockerfile).
# Если 8080 на сервере уже занят другим проектом — смените на свободный.
HOST_PORT=8090

# Доступ с внешних (не локальных/туннельных) адресов включается не здесь —
# переключатель на странице /settings в самой панели, хранится в её БД, без
# правки .env и рестарта контейнера (см. README_broadcast.md).

# Secure-флаг сессионной cookie: 0 при доступе через SSH-туннель (http://127.0.0.1),
# 1 — если админка опубликована за HTTPS (reverse-proxy/Cloudflare)
COOKIE_SECURE=0

# Всё остальное поведение (пауза между отправками, TTL кэша членства,
# исключённые чаты, chat ID администратора, названия ботов, уровень
# логирования, период тика очереди) — тоже не здесь, а на странице
# /settings внутри самой панели. Первый запуск подхватит разумные
# значения по умолчанию, менять можно сразу из интерфейса.
